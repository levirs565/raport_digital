{
  "name": "@raport-digital/server",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "args": [
            "node-env=production"
          ],
          "runtimeArgs": [
            "--experimental-require-module"
          ]
        },
        "configurations": {
          "development": {
            "args": [
              "node-env=development"
            ]
          }
        }
      },
      "serve": {
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@raport-digital/server:build",
          "runBuildTargetDependencies": false,
          "runtimeArgs": [
            "--experimental-require-module"
          ]
        },
        "configurations": {
          "development": {
            "buildTarget": "@raport-digital/server:build:development"
          },
          "production": {
            "buildTarget": "@raport-digital/server:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      }
    }
  },
  "scripts": {
    "add-account": "ts-node --project tsconfig.app.json ./src/add-account.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.948.0",
    "@nestjs/passport": "^11.0.5",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0"
  },
  "devDependencies": {
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38"
  }
}
